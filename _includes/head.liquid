<!-- Metadata about the site -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<title>
  {% if page.title and page.title != 'blank' and page.url != '/' %}
    {% if page.title == 'blog' %}
      {{ site.blog_name }}
    {% else %}
      {{ page.title }} | {{ site.title }}
    {% endif %}
  {% else %}
    {{ site.title }}
  {% endif %}
</title>

<!-- Inter Font & JetBrains Mono for Plainwhite / Minimal Mistakes aesthetic -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<!-- Custom Site CSS Override -->
<link rel="stylesheet" href="{{ '/assets/css/custom.css' | relative_url }}">

{% if site.al_folio.compat.bootstrap.enabled %}
  <!-- Optional Bootstrap compatibility layer -->
  <link rel="stylesheet" href="{{ '/assets/css/bootstrap-compat.css' | relative_url | bust_file_cache }}">
{% endif %}
